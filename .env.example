# Copie para .env (que NÃO é versionado) e preencha.
DATABASE_URL="file:./db/custom.db"

# Obrigatório em produção: >= 32 caracteres aleatórios.
#   openssl rand -base64 48
ASTROFEET_AUTH_SECRET=

# Primeiro administrador em produção (não existem contas de demonstração).
# Senha com >= 12 caracteres.
ASTROFEET_ADMIN_EMAIL=
ASTROFEET_ADMIN_PASSWORD=

# Origens extras autorizadas a chamar a API (separadas por vírgula).
# Por padrão só o próprio host é aceito.
ASTROFEET_ALLOWED_ORIGINS=

# Caminho do arquivo do banco (padrão: ./db/astrofeet.json). Use um volume persistente em produção.
ASTROFEET_DB_PATH=
